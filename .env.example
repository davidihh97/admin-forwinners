# Copia este archivo como .env y llena los valores de tu proyecto de Supabase.
# Si los dejas vacíos, el panel funciona en "modo local" (datos guardados solo en este navegador).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Correo del único usuario administrador creado en Supabase (no se muestra en el login).
VITE_ADMIN_EMAIL=admin@forwinnersec.com
