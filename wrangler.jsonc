{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-forwinners",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // La MISMA base de datos que forwinnersec.com. Las tablas se crean con las migraciones
  // del repositorio for-winners-website (0004_admin_panel.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "for-winners-db",
      "database_id": "9bf5c7c6-0937-48a8-8b60-0952875f1016",
      "migrations_dir": "no-migrations"
    }
  ],
  "vars": {
    // Página que se abre en el editor visual.
    "SITE_URL": "https://forwinnersec.com"
  },
  // Dominio del panel (requiere que forwinnersec.com esté en Cloudflare).
  "routes": [{ "pattern": "admin.forwinnersec.com", "custom_domain": true }]
  // Secreto (no va aquí): npx wrangler secret put ADMIN_PASSWORD
}
